# Myrmex — local secrets. Copy this file to .env (gitignored) and fill in what you use.
#
# Godot does not read .env itself: a small loader in the app/server layer parses it into
# the process environment at startup, and real environment variables always take
# precedence over the file. Tests use the MOCK provider and need no key at all.

# The queen's strategy model — the default provider (Google AI API).
GEMINI_API_KEY=

# Optional alternatives behind the same provider seam (v1.5+).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# Server only (v4) — supplied by systemd EnvironmentFile= in a deployment.
# MYRMEX_TOKEN=
# MYRMEX_PORT=8765
# MYRMEX_SAVE_DIR=/var/lib/myrmex/saves
